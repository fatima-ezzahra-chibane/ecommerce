    {
      "name": "5. Commandes",
      "item": [
        {
          "name": "Passer commande",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const o = pm.response.json().data || pm.response.json();",
                  "  if (o.id) pm.environment.set('order_id', o.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shipping_address\": \"123 Avenue Hassan II, Casablanca\",\n  \"payment_method\": \"card\"\n}"
            },
            "url": "{{base_url}}/orders"
          }
        },
